# Copy the values into your host's environment (Render, Docker, your shell). Never commit real values.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5433/khedma
DB_USERNAME=khedma
DB_PASSWORD=khedma

# Signing key for access tokens: a random string of at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Comma-separated emails that become SUPER_ADMIN once verified
SUPER_ADMIN_EMAILS=

# Web app origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google sign-in (optional): OAuth client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# Push notifications (optional): a VAPID key pair identifies this server to browsers' push services.
# Generate once, e.g. `npx web-push generate-vapid-keys`, keep the private key secret.
# VAPID_SUBJECT is a contact the push services can use: a mailto: address or your site's https URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Verification / reset emails. Brevo's HTTPS API is preferred (works where SMTP ports are blocked).
MAIL_FROM=
BREVO_API_KEY=
# ...or plain SMTP instead of Brevo
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
